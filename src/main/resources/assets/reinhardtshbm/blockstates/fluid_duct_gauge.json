{
  "multipart": [
    { "apply": { "model": "reinhardtshbm:block/fluid_duct_gauge" } },
    { "when": { "facing": "north" }, "apply": { "model": "reinhardtshbm:block/fluid_duct_gauge_face" } },
    { "when": { "facing": "south" }, "apply": { "model": "reinhardtshbm:block/fluid_duct_gauge_face", "y": 180 } },
    { "when": { "facing": "east" }, "apply": { "model": "reinhardtshbm:block/fluid_duct_gauge_face", "y": 90 } },
    { "when": { "facing": "west" }, "apply": { "model": "reinhardtshbm:block/fluid_duct_gauge_face", "y": 270 } },
    { "when": { "facing": "up" }, "apply": { "model": "reinhardtshbm:block/fluid_duct_gauge_face", "x": 270 } },
    { "when": { "facing": "down" }, "apply": { "model": "reinhardtshbm:block/fluid_duct_gauge_face", "x": 90 } }
  ]
}
