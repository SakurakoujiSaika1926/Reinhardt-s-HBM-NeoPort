    { "when": { "east": "true" }, "apply": { "model": "reinhardtshbm:block/fence_metal_side", "y": 90, "uvlock": true } },
    { "when": { "south": "true" }, "apply": { "model": "reinhardtshbm:block/fence_metal_side", "y": 180, "uvlock": true } },
    { "when": { "west": "true" }, "apply": { "model": "reinhardtshbm:block/fence_metal_side", "y": 270, "uvlock": true } }
  ]
